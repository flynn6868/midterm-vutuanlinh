{
  "cases": [
    {
      "name": "happy_path_staff_confirms",
      "type": "happy_path",
      "input": [
        {
          "do": "create",
          "as": "client",
          "data": {
            "request_id": "T-1",
            "client": "client-a",
            "service_id": "S1",
            "stylist": "Ana",
            "start": "2026-11-02 09:00"
          }
        },
        {
          "do": "move",
          "as": "staff",
          "item": 1,
          "to": "confirmed"
        }
      ],
      "expected": {
        "outcome": "accepted",
        "state": "confirmed"
      },
      "how_computed": "staff may move booked -> confirmed, so accepted and the state becomes confirmed"
    },
    {
      "name": "client_cannot_confirm",
      "type": "role_not_allowed",
      "input": [
        {
          "do": "create",
          "as": "client",
          "data": {
            "request_id": "T-2",
            "client": "client-a",
            "service_id": "S1",
            "stylist": "Ana",
            "start": "2026-11-02 09:00"
          }
        },
        {
          "do": "move",
          "as": "client",
          "item": 1,
          "to": "confirmed"
        }
      ],
      "expected": {
        "outcome": "not_permitted",
        "state": "booked"
      },
      "how_computed": "Only staff may move booked -> confirmed; a client tried, so it is rejected and the item stays booked"
    },
    {
      "name": "client_cannot_mark_arrived",
      "type": "role_not_allowed",
      "input": [
        {
          "do": "create",
          "as": "client",
          "data": {
            "request_id": "T-3",
            "client": "client-a",
            "service_id": "S1",
            "stylist": "Ana",
            "start": "2026-11-02 09:00"
          }
        },
        {
          "do": "move",
          "as": "staff",
          "item": 1,
          "to": "confirmed"
        },
        {
          "do": "move",
          "as": "client",
          "item": 1,
          "to": "arrived"
        }
      ],
      "expected": {
        "outcome": "not_permitted",
        "state": "confirmed"
      },
      "how_computed": "Only staff may move confirmed -> arrived; a client tried, so it is rejected and the item stays confirmed"
    },
    {
      "name": "skip_to_completed",
      "type": "illegal_move",
      "input": [
        {
          "do": "create",
          "as": "client",
          "data": {
            "request_id": "T-4",
            "client": "client-a",
            "service_id": "S1",
            "stylist": "Ana",
            "start": "2026-11-02 09:00"
          }
        },
        {
          "do": "move",
          "as": "staff",
          "item": 1,
          "to": "completed"
        }
      ],
      "expected": {
        "outcome": "illegal_move",
        "state": "booked"
      },
      "how_computed": "booked -> completed is not in the state table (skips confirmed and arrived), so it is illegal_move and the item stays booked"
    },
    {
      "name": "client_cancels_booked",
      "type": "cancel",
      "input": [
        {
          "do": "create",
          "as": "client",
          "data": {
            "request_id": "T-5",
            "client": "client-a",
            "service_id": "S1",
            "stylist": "Ana",
            "start": "2026-11-02 09:00"
          }
        },
        {
          "do": "move",
          "as": "client",
          "item": 1,
          "to": "cancelled"
        }
      ],
      "expected": {
        "outcome": "accepted",
        "state": "cancelled"
      },
      "how_computed": "client may cancel from booked, so accepted and the state becomes cancelled"
    },
    {
      "name": "duplicate_request_id",
      "type": "seeded_failure",
      "input": [
        {
          "do": "create",
          "as": "client",
          "data": {
            "request_id": "T-6",
            "client": "client-a",
            "service_id": "S1",
            "stylist": "Ana",
            "start": "2026-11-02 09:00"
          }
        },
        {
          "do": "create",
          "as": "client",
          "data": {
            "request_id": "T-6",
            "client": "client-b",
            "service_id": "S1",
            "stylist": "Ben",
            "start": "2026-11-02 11:00"
          }
        }
      ],
      "expected": {
        "outcome": "duplicate_request"
      },
      "how_computed": "request_id T-6 was already used by the first create, so the second is rejected and makes no item"
    },
    {
      "name": "restart_keeps_booking",
      "type": "restart",
      "input": [
        {
          "do": "create",
          "as": "client",
          "data": {
            "request_id": "T-7",
            "client": "client-a",
            "service_id": "S1",
            "stylist": "Ana",
            "start": "2026-11-02 09:00"
          }
        },
        {
          "do": "restart"
        },
        {
          "do": "list"
        }
      ],
      "expected": {
        "outcome": "accepted",
        "count": 1
      },
      "how_computed": "one booking was created and a restart keeps saved data, so one item"
    },
    {
      "name": "seeded_bad_date_format",
      "type": "seeded_failure",
