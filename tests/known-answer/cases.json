          }
        }
      ],
      "expected": {
        "outcome": "after_close"
      },
      "how_computed": "B-007 is S4 (30 min) starting 16:45, so it ends 17:15, after 17:00 close"
    },
    {
      "name": "seeded_conflict",
      "type": "seeded_failure",
      "input": [
        {
          "do": "create",
          "as": "client",
          "data": {
            "request_id": "B-001",
            "client": "client-a",
            "service_id": "S1",
            "stylist": "Ana",
            "start": "2026-11-02 09:00"
          }
        },
        {
          "do": "create",
          "as": "client",
          "data": {
            "request_id": "B-002",
            "client": "client-b",
            "service_id": "S2",
            "stylist": "Ana",
            "start": "2026-11-02 09:30"
          }
        }
      ],
      "expected": {
        "outcome": "conflict"
      },
      "how_computed": "B-001 (Ana, S1 45 min) runs 09:00-09:45; B-002 starts 09:30 for the same stylist, so it overlaps and the earlier request keeps the slot"
    },
