        {
          "do": "create",
          "as": "client",
          "data": {
            "request_id": "B-005",
            "client": "client-e",
            "service_id": "S4",
            "stylist": "Ben",
            "start": "11/02/2026 10:30"
          }
        }
      ],
      "expected": {
        "outcome": "bad_date_format"
      },
      "how_computed": "B-005 start is 11/02/2026 10:30, not YYYY-MM-DD HH:MM, so it is rejected and makes no item"
    },
    {
      "name": "seeded_after_close",
      "type": "seeded_failure",
      "input": [
        {
          "do": "create",
          "as": "client",
          "data": {
            "request_id": "B-007",
            "client": "client-g",
            "service_id": "S4",
            "stylist": "Ana",
